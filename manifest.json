{
  "manifest_version": 3,
  "name": "SpotiX — Spotify Web Customizer",
  "version": "1.7.0.11",
  "description": "Themes, color customization, touch UI scale, pitch-coupled speed, forced-highest quality & ad blocker for Spotify Web Player.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SpotiX",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "sx-css.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sx-adblock.js",
        "sx-dsp.js"
      ],
      "matches": [
        "https://open.spotify.com/*"
      ]
    }
  ]
}